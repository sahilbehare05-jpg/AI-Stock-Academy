# ==== Backend Environment Variables ====

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_stock_academy

# JWT
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Starting virtual wallet balance for new users (INR)
STARTING_VIRTUAL_BALANCE=100000

# Optional: News API key (leave blank to use empty/demo state)
NEWS_API_KEY=
